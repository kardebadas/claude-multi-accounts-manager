#!/usr/bin/env bash
# claude-multi — manage multiple Claude Code accounts by pointing
# CLAUDE_CONFIG_DIR at a per-account config folder.
#
# Executable AND source-able: the main guard at the bottom means the test suite
# can source this file and call functions directly.
#
# stdout belongs to claude. Every diagnostic here goes to stderr, so
# `claude-multi work -p "…" | jq` is never corrupted.
set -euo pipefail

CLAUDE_MULTI_PROG="claude-multi"
CLAUDE_MULTI_VERSION="0.1.0"

# Resolve this script through any chain of symlinks, so lib/ is still found
# when invoked via the ~/.local/bin/claude-multi link that install.sh creates.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _link="$(readlink -- "$_self")"
  case "$_link" in
    /*) _self="$_link" ;;
    *) _self="$(dirname -- "$_self")/$_link" ;;
  esac
done
CLAUDE_MULTI_LIB="$(cd -- "$(dirname -- "$_self")/../lib" && pwd)"
unset _self _link

# shellcheck source=../lib/config.sh
source "$CLAUDE_MULTI_LIB/config.sh"
# shellcheck source=../lib/util.sh
source "$CLAUDE_MULTI_LIB/util.sh"
# shellcheck source=../lib/links.sh
source "$CLAUDE_MULTI_LIB/links.sh"
# shellcheck source=../lib/seed.sh
source "$CLAUDE_MULTI_LIB/seed.sh"
# shellcheck source=../lib/memory.sh
source "$CLAUDE_MULTI_LIB/memory.sh"
# shellcheck source=../lib/accounts.sh
source "$CLAUDE_MULTI_LIB/accounts.sh"
# shellcheck source=../lib/launch.sh
source "$CLAUDE_MULTI_LIB/launch.sh"
# shellcheck source=../lib/menu.sh
source "$CLAUDE_MULTI_LIB/menu.sh"

usage() {
  cat >&2 <<'USAGE'
Usage:
  claude-multi                    interactive account menu
  claude-multi <account> [args…]  launch claude in <account>; args pass through

  --help, -h   this message
  --version    print the version

There are no subcommands: add / delete / sync / doctor live inside the menu, so
`claude-multi add` always means "launch the account named add".

All claude-multi output goes to stderr; stdout belongs to claude.
USAGE
}

# dispatch_args [args…]
dispatch_args() {
  if (( $# > 0 )); then
    case "$1" in
      --help | -h)
        usage
        return 0
        ;;
      --version)
        printf '%s %s\n' "$CLAUDE_MULTI_PROG" "$CLAUDE_MULTI_VERSION" >&2
        return 0
        ;;
    esac
  fi

  if [[ ! -d "$(multi_root)" ]]; then
    first_run_wizard || return 1
    menu_loop
    return
  fi

  if (( $# == 0 )); then
    menu_loop
    return
  fi

  if ! validate_name "$1"; then
    return 1
  fi
  shift
  launch_account "$CANONICAL_NAME" "$@"
}

main() {
  require_bash4 || return 1
  local root="" resolved_root=""
  root="$(multi_root)"
  validate_root_path "$root" || return 1
  if [[ -e "$root" || -L "$root" ]]; then
    _resolve_managed_root || return 1
    if [[ "$root" != "$_SAFE_MANAGED_ROOT" ]]; then
      log "refusing operation: symlinked managed root '$root' resolves to '$_SAFE_MANAGED_ROOT'"
      return 1
    fi
  else
    resolved_root="$(readlink -m -- "$root")" || {
      log "refusing operation: cannot resolve managed root '$root'"
      return 1
    }
    if [[ "$root" != "$resolved_root" ]]; then
      log "refusing operation: symlinked managed root '$root' resolves to '$resolved_root'"
      return 1
    fi
  fi
  dispatch_args "$@"
}

# main guard: run only when executed, not when sourced by the tests.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
