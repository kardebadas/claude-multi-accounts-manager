#!/usr/bin/env bash
# tests/fake-claude — stub `claude` for the test suite.
#
# claude-multi resolves `claude` through PATH, so a test can point PATH at a
# directory containing a symlink named `claude` to this file. It records what it
# was handed and exits; it never launches anything.
#
#   FAKE_CLAUDE_LOG     where to record  (default $TEST_TMP/fake-claude.log,
#                                          falling back to /tmp/fake-claude.log)
#   FAKE_CLAUDE_EXIT    exit status      (default 0)
#   FAKE_CLAUDE_STDOUT  bytes to write to stdout, verbatim (default: unset,
#                                          and then not one byte is written)
#
# Standard wiring, kept inline in each test that needs it:
#
#   mkdir -p "$TEST_TMP/bin"
#   ln -sf "$REPO_ROOT/tests/fake-claude" "$TEST_TMP/bin/claude"
#   export PATH="$TEST_TMP/bin:$PATH"
#   export FAKE_CLAUDE_LOG="$TEST_TMP/invocation"
#
# Those four lines are not the whole wiring. `ln -sf` to a missing target makes
# a dangling link without complaint, and `command -v claude` then walks straight
# past it to whatever real `claude` is installed; appending to PATH instead of
# prepending has the same effect while the stub sits there present and +x. So a
# test file must refuse to run — before it dispatches a single test — unless PATH
# resolves `claude` to *this* file, compared as fully resolved paths rather than
# as strings that look alike. `require_fake_claude_wiring` in
# tests/test_fake_claude.sh is the reference implementation.
#
# ── RECORD FORMAT (three files, all truncated on every invocation) ──────────
#
# THE SIDECARS ARE THE AUTHORITY. $FAKE_CLAUDE_LOG is for reading by eye when a
# test fails; Phase 6 must assert against $FAKE_CLAUDE_LOG.argv and
# $FAKE_CLAUDE_LOG.env, never against the line log. The reason is not style: the
# line log is forgeable from argv. One argument containing a newline followed by
# `PWD=/spoofed` or `CLAUDE_CONFIG_DIR=/other-account` puts those exact lines in
# the log, and `assert_contains` cannot tell them from the real ones — so a
# launch test that (correctly) exercises a hostile prompt would be asserting on
# bytes the prompt itself wrote.
#
# $FAKE_CLAUDE_LOG — line-oriented, for readable assertions and eyeballing.
# Exactly:
#
#   ARGC=<n>                          the number of arguments
#   ARG=<value>                       one line per argument, in order (n lines)
#   CLAUDE_CONFIG_DIR=<value>         empty if unset
#   CLAUDE_CODE_PLUGIN_CACHE_DIR=<value>   empty if unset
#   HOME=<value>                      empty if unset
#   PWD=<value>                       the caller's cwd
#
# Not authoritative, on any line: an argument containing a newline spans several
# lines and can therefore fabricate any line above it, and an empty argument is
# indistinguishable from an empty value.
#
# $FAKE_CLAUDE_LOG.argv — the authoritative argv: each argument followed by a
# NUL byte, nothing else. NUL is the one byte an argument cannot contain, so
# spaces, tabs, quotes, globs, leading dashes and newlines all round-trip
# exactly. Zero arguments leaves a zero-byte file; one empty argument leaves a
# single NUL byte. Read it back with:
#
#   declare -a argv=()
#   while IFS= read -r -d '' a; do argv+=("$a"); done <"$log.argv"
#
# $FAKE_CLAUDE_LOG.env — the authoritative environment: four NUL-terminated
# `NAME=value` entries, in this order, always all four present —
# CLAUDE_CONFIG_DIR, CLAUDE_CODE_PLUGIN_CACHE_DIR, HOME, PWD. An unset variable
# records as an empty value, never as a missing entry, so "exported as empty" is
# a distinguishable answer rather than a silent absence. The name is everything
# up to the first `=`; the value is the rest, so a value carrying its own `=`
# signs or newlines cannot invent an extra entry. Read it back with:
#
#   declare -A envrec=()
#   while IFS= read -r -d '' e; do envrec["${e%%=*}"]="${e#*=}"; done <"$log.env"
#
# $FAKE_CLAUDE_LOG.rejected — present only after the stub refused a malformed
# FAKE_CLAUDE_EXIT (see below). Removed by every accepted invocation.
#
# ── STDOUT — silent by default, and one opt-in knob ─────────────────────────
# With FAKE_CLAUDE_STDOUT unset or empty this stub writes nothing to stdout,
# ever — not one byte. Phase 6 asserts the launch path leaves stdout byte-empty
# so `claude-multi work -p "…" | jq` is never corrupted, and that assertion
# must measure claude-multi alone. Everything a test needs to read is in the
# sidecars above; diagnostics go to stderr, and the success path emits none of
# those either, so a test may assert on claude-multi's stderr without the
# stub's voice in it.
#
# FAKE_CLAUDE_STDOUT exists for the converse half of that guarantee. Phase 6
# must also prove that *claude's own* stdout reaches the caller unmodified, and
# against an always-silent stub a launch path that swallowed claude's stdout
# entirely would pass byte-for-byte identically to a correct one. When the knob
# is set, the stub writes exactly those bytes and nothing else — no trailing
# newline, no quoting, no reformatting — so a test can byte-compare what came
# out of claude-multi against what it fed in. It is written before the exit, so
# a "printed, then failed" launch is reproducible too. Unset it and every
# byte-empty assertion in this suite holds unchanged.
set -euo pipefail

log="${FAKE_CLAUDE_LOG:-${TEST_TMP:-/tmp}/fake-claude.log}"
mkdir -p -- "$(dirname -- "$log")"

{
  printf 'ARGC=%s\n' "$#"
  for a in "$@"; do
    printf 'ARG=%s\n' "$a"
  done
  printf 'CLAUDE_CONFIG_DIR=%s\n' "${CLAUDE_CONFIG_DIR-}"
  printf 'CLAUDE_CODE_PLUGIN_CACHE_DIR=%s\n' "${CLAUDE_CODE_PLUGIN_CACHE_DIR-}"
  printf 'HOME=%s\n' "${HOME-}"
  printf 'PWD=%s\n' "$PWD"
} >"$log"

# Truncated first, so zero arguments leaves an empty file rather than a stale
# one from the previous invocation.
: >"$log.argv"
for a in "$@"; do
  printf '%s\0' "$a" >>"$log.argv"
done

# The authoritative environment record. Spelled out one variable at a time
# rather than looped over indirect expansions: four lines are cheaper than a
# version-sensitive `${!v-}`, and the order is then obvious from the source.
{
  printf 'CLAUDE_CONFIG_DIR=%s\0' "${CLAUDE_CONFIG_DIR-}"
  printf 'CLAUDE_CODE_PLUGIN_CACHE_DIR=%s\0' "${CLAUDE_CODE_PLUGIN_CACHE_DIR-}"
  printf 'HOME=%s\0' "${HOME-}"
  printf 'PWD=%s\0' "$PWD"
} >"$log.env"

# A rejection marker from a previous invocation must not condemn this one.
rm -f -- "$log.rejected"

# Every record is complete before this point, so a test can still inspect what
# a failing launch — or a refused one — was handed.

# The exit knob is validated before anything is written to stdout, so the
# refusal path is still byte-empty on stdout.
#
# Why validate at all, when the brief said just `exit "${FAKE_CLAUDE_EXIT:-0}"`:
# `exit 256` wraps silently to status 0, so one mistyped knob would hand a
# launch test a *passing* status for a failing launch — the worst possible
# failure mode for the instrument the whole launch suite is measured with.
#
# Why 64 and a marker file, rather than the 2 this used to exit with: 2 is a
# status the real `claude` can plausibly return, so "the launch forwarded status
# 2" could be satisfied by a typo in the test's own knob instead of by the
# product. No exit status is truly unambiguous — every one of 0-255 is something
# a caller could legitimately have asked for — so the definitive signal is out of
# band: a named marker file that only a refusal creates. 64 is EX_USAGE, chosen
# so the status is unlikely on its own; $log.rejected is what makes it certain.
code="${FAKE_CLAUDE_EXIT:-0}"
if [[ ! "$code" =~ ^[0-9]{1,3}$ ]] || ((10#$code > 255)); then
  # `exit notanumber` would abort with bash's own "numeric argument required",
  # which names this file's line number instead of the mistake. Say it plainly.
  printf '%s' "$code" >"$log.rejected"
  printf 'tests/fake-claude: FAKE_CLAUDE_EXIT must be an integer 0-255; got [%s] (refused; see %s)\n' \
    "$code" "$log.rejected" >&2
  exit 64
fi

# The one deliberate write to stdout. `printf '%s'` adds nothing: the caller's
# bytes arrive exactly as given, and an unset or empty knob writes zero bytes.
if [[ -n "${FAKE_CLAUDE_STDOUT-}" ]]; then
  printf '%s' "$FAKE_CLAUDE_STDOUT"
fi

exit "$code"
